#!/usr/bin/env bash
# lidsleep — control whether closing the laptop lid suspends.
# Lid sleep is "off" while a user service holds a logind handle-lid-switch
# inhibitor. Whether that service is enabled is the saved default applied at
# each login; on/off without --permanent only change things until logout.

set -euo pipefail

UNIT=lidsleep.service
UNIT_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT
UNIT_TEXT='[Unit]
Description=Stop lid close from suspending (lidsleep)

[Service]
ExecStart=/usr/bin/systemd-inhibit --what=handle-lid-switch --who=lidsleep "--why=Lid close suspend disabled" --mode=block /usr/bin/sleep infinity

[Install]
WantedBy=default.target'

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
    B=$'\e[1m' DIM=$'\e[2m' GRN=$'\e[1;32m' YEL=$'\e[1;33m' RST=$'\e[0m'
else
    B='' DIM='' GRN='' YEL='' RST=''
fi

sc() { systemctl --user --quiet "$@"; }
now_state()     { if sc is-active "$UNIT"; then echo off; else echo on; fi; }
default_state() { if sc is-enabled "$UNIT" 2>/dev/null; then echo off; else echo on; fi; }

# Write the unit file if it's missing or out of date.
install_unit() {
    [[ $(cat "$UNIT_FILE" 2>/dev/null) == "$UNIT_TEXT" ]] && return
    mkdir -p "${UNIT_FILE%/*}"
    printf '%s\n' "$UNIT_TEXT" > "$UNIT_FILE"
    systemctl --user daemon-reload
}

# set on|off [permanent]
set_state() {
    if [[ $1 == off ]]; then
        install_unit
        sc start "$UNIT"
        [[ -z ${2:-} ]] || sc enable "$UNIT"
    else
        sc stop "$UNIT" 2>/dev/null || true
        [[ -z ${2:-} ]] || sc disable "$UNIT" 2>/dev/null || true
    fi
}

status() {
    local now def color note
    now=$(now_state) def=$(default_state)
    [[ $now == on ]] && color=$GRN || color=$YEL
    [[ $now == "$def" ]] && note="permanent" || note="until logout, then $def"
    echo "Lid sleep: ${color}${now}${RST} ${DIM}(${note})${RST}"
}

usage() {
    cat <<EOF
${B}Usage:${RST} lidsleep on|off|toggle [-p]
       lidsleep status|help

  ${B}on${RST}       closing the lid suspends
  ${B}off${RST}      closing the lid does nothing
  ${B}toggle${RST}   switch between on and off
  ${B}status${RST}   show the current setting ${DIM}(the default with no arguments)${RST}
  ${B}help${RST}     show this help

  ${B}-p${RST}, ${B}--permanent${RST}   keep the change after logout and reboot
                    ${DIM}(without it, the change lasts until logout)${RST}
EOF
}

bad() { echo "lidsleep: $*" >&2; usage >&2; exit 2; }

cmd=${1:-status} perm=''
[[ $# -le 2 ]] || bad "too many arguments"
case ${2:-} in
    '') ;;
    -p|--permanent)
        [[ $cmd == on || $cmd == off || $cmd == toggle ]] || bad "${2} only goes with on, off or toggle"
        perm=1 ;;
    *) bad "unknown option '$2'" ;;
esac

case $cmd in
    on|off)         set_state "$cmd" $perm; status ;;
    toggle)         if [[ $(now_state) == off ]]; then set_state on $perm; else set_state off $perm; fi; status ;;
    status)         status ;;
    help|-h|--help) usage ;;
    *)              bad "unknown command '$cmd'" ;;
esac
